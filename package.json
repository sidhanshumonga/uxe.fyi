  "description": "The open-source home for UX Engineering — a living handbook, a career bridge, and a community.",
  "homepage": "https://uxe.fyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidhanshumonga/uxe.fyi.git"
